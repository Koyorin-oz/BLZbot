node_modules/

# Secrets & environnement local (ne jamais commit)
# (.env = n’importe quel dossier ; .env.* sauf le modèle)
.env
.env.*
!.env.example

# OAuth / clés fichiers
credentials.json
token.json

# Bases SQLite & état local (recréées au runtime)
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs locaux
link_logs.txt

# Données runtime à la racine
candidate_votes.json
channelActivity.json

# Logs & OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Cursor : cache ignore, hooks OFF (plus de sync), rules gardees
.cursor/*
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/rules/
.idea/
*.swp

# VScode
.vscode/

# Optionnel : caches
.cache/

# Perso / brouillons (bot de test, notes — pas besoin de versionner)
reborn-test-bot/REBORN-CHECKLIST-DISCORD.md
reborn-discord-messages.md


votes.json