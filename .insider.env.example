# Copie ce fichier en .insider.env, puis utilise des identifiants propres au bot Insider.
# npm run dev recharge automatiquement le bot quand un fichier JavaScript suivi change.
BOT_TOKEN=
CLIENT_ID=
GUILD_ID=
BLZ_AUTO_DEPLOY_SLASH=0
# Les bases SQLite Insider sont séparées par défaut dans niveau/src/database/insider.
# Pour changer cet emplacement (chemin absolu ou relatif à la racine du dépôt) :
# BLZ_INSIDER_DATABASE_DIR=

# Exemples de salons et rôles spécifiques au serveur Insider
GUILD_CHANNEL=
GUILD_CATEGORY=
COMPTAGE=
TUTORIAL_CHANNEL=
QUEST_CHANNEL=
LEVEL_UP_CHANNEL=
RANK_UP_CHANNEL=
STREAK_CHANNEL=
HACKER_CHANNEL=
HACKER_ROLE_ID=
REGLEMENT_ROLE=

# Optionnel : autres variables utilisées par BLZbot (IA, salons vocaux, événements, etc.)
# Ajoute-les ici avec leurs valeurs Insider ; le .env principal n'est pas chargé par npm run dev.
