# Copie ce fichier en .env à côté (même dossier reborn-test-bot/)
# Le programme charge : reborn-test-bot/.env

# Portail Discord → application de TEST → Bot → onglet « Privileged Gateway Intents » :
#   cocher « MESSAGE CONTENT INTENT » et « SERVER MEMBERS INTENT » (sinon erreur « Used disallowed intents »).
#   Alternative provisoire : REBORN_MINIMAL_DISCORD_INTENTS=1 (certaines commandes seront limitées).
# Portail Discord → application de TEST → Bot → token (sans guillemets, une seule ligne)
REBORN_TEST_BOT_TOKEN=

# Portail Discord → application de TEST → nom en haut : « ID de l'application »
# (bot de test actuel — avril 2026)
REBORN_TEST_BOT_CLIENT_ID=1498205315907453038

# Discord → Paramètres → Avancés → « Mode développeur » ON
# Clic droit sur le SERVEUR de test → Copier l'identifiant du serveur
REBORN_TEST_GUILD_ID=1493276404643532810

# Optionnel : IDs Discord (séparés par des virgules) pour les commandes owner si besoin
REBORN_TEST_OWNER_IDS=

# 1 (défaut) = limites actives (cooldown hacker 12 h, etc.). 1 = sandbox sans limites.
# REBORN_TEST_NO_LIMITS=0

# 1 (défaut) = enregistrer les slash commands à chaque démarrage du bot. 0 = désactiver.
REBORN_AUTO_DEPLOY_SLASH=1 (optionnel — même idée que STREAK_CHANNEL du bot principal).
# REBORN_STREAK_CHANNEL_ID=

# Rôle Discord « Hackeur » (attribué à l’obtention du jeton hacker).
REBORN_HACKER_ROLE_ID=1432469784653467701

# Salon secret hacker (serveur principal). Sur le serveur de test : TEST_HACKER_CHANNEL dans le .env racine.
REBORN_HACKER_CHANNEL_ID=1454484970843144391

# 1 (défaut) = déployer aussi les slash du dossier niveau (bot principal) sur cette appli ; 0 = uniquement les commandes reborn-test-bot.
# ⚠️ Si = 0, **pas de /profil** (il vient de niveau/src/commands/core/profil.js).
REBORN_MIRROR_NIVEAU_SLASH=1

# 1 (défaut) = exécuter le vrai code des commandes « niveau » (BDD / canvas = même stack que BLZbot, dépendances à la racine du repo). 0 = message « utiliser BLZbot » (stub).
REBORN_MIRROR_NIVEAU_EXECUTE=1

# 0 (défaut) = demander les intents complets. 1 = sans MessageContent / GuildMembers (dépanne si intents pas cochés au portail).
# REBORN_MINIMAL_DISCORD_INTENTS=0

# ──────────────────────────────────────────────────────────────────────────
# REBORN finition (mai 2026)
# ──────────────────────────────────────────────────────────────────────────

# Salon où poster les logs des Focus de guilde (anti-abus). Si vide, on
# cherche LOGS_CHANNEL_ID en fallback. Si rien, juste l'audit DB est gardé.
FOCUS_LOG_CHANNEL_ID=
LOGS_CHANNEL_ID=

# Plafond anti-abus : max focus **lancés** par guilde **attaquante** sur 24 h (en plus du CD 7 j).
# 0 = désactivé (seul le cooldown 7 j compte). Défaut : 3.
# FOCUS_MAX_PER_ATTACKER_GUILD_PER_DAY=3

# (À mettre sur le **processus niveau / BLZbot**, pas obligatoirement ici.) 1 = les victoires
# `/minijeu` incrémentent `quests.trackMinijeuWin` dans la BDD **reborn-test-bot** (monorepo).
# REBORN_QUEST_HOOK=0

# Bypass des boutons /profil niveau pour laisser reborn-test-bot prendre la
# main. Mettre à 1 si tu veux que le bot REBORN gère ces actions.
REBORN_PROFIL_QUEST_BYPASS=1
REBORN_PROFIL_GUILD_BYPASS=1
REBORN_PROFIL_ARBRE_BYPASS=1
REBORN_PROFIL_CLASSES_BYPASS=1
